APP_ENV=local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hootoom_forum
DB_USERNAME=root
DB_PASSWORD=change-me
FLYWAY_BASELINE_ON_MIGRATE=true
LOG_FORMAT=console
LOG_LEVEL_ROOT=INFO
PROFILE_ALLOWED_AVATAR_KEYS=default-1,default-2,default-3,default-4,default-5,default-6,default-7,default-8
AUTH_VERIFICATION_TOKEN_MINUTES=30
AUTH_PASSWORD_RESET_TOKEN_MINUTES=15
AUTH_REGISTRATION_LIMIT_PER_HOUR=5
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_TOKEN_ISSUER=hootoom-forum-api
AUTH_TOKEN_AUDIENCE=hootoom-forum-web
AUTH_TOKEN_KEY_ID=local-dev-key
AUTH_TOKEN_PRIVATE_KEY=
AUTH_TOKEN_PUBLIC_KEY=
AUTH_COOKIE_SECURE=false
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080
CURRENT_POLICY_VERSION=2026-10-07
MAIL_VERIFICATION_BASE_URL=http://localhost:3000/verify-email
MAIL_PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password
# Generate locally: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
MAIL_OUTBOX_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
MAIL_FROM=no-reply@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_OUTBOX_BATCH_SIZE=20
MAIL_OUTBOX_MAX_RETRIES=5
MAIL_OUTBOX_POLL_DELAY_MS=5000
MAIL_OUTBOX_LOCK_TIMEOUT_MINUTES=10
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_POLICY_VERSION=2026-10-07
