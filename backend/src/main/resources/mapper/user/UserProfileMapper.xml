<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hootoom.forum.user.mapper.UserProfileMapper">
    <resultMap id="UserResult" type="com.hootoom.forum.auth.entity.ForumUser">
        <id property="id" column="id"/><result property="username" column="username"/>
        <result property="email" column="email"/><result property="emailVerifiedAt" column="email_verified_at"/>
        <result property="nickname" column="nickname"/><result property="avatarKey" column="avatar_key"/>
        <result property="bio" column="bio"/><result property="status" column="status"/>
        <result property="version" column="version"/>
    </resultMap>
    <select id="findById" resultMap="UserResult">
        SELECT id, username, email, email_verified_at, nickname, avatar_key, bio, status, version
        FROM forum_user WHERE id = #{userId} LIMIT 1
    </select>
    <update id="updateProfile">
        UPDATE forum_user
        SET nickname = #{nickname}, bio = #{bio}, avatar_key = #{avatarKey},
            updated_at = UTC_TIMESTAMP(3), version = version + 1
        WHERE id = #{userId} AND status = 'ACTIVE' AND version = #{version}
    </update>
</mapper>
